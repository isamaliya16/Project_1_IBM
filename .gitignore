# NutriGuide AI — .gitignore

# Python
__pycache__/
*.py[cod]
*.pyo
*.pyd
.Python
*.egg-info/
dist/
build/
*.egg
*.whl
*.spec

# Virtual environments
venv/
env/
.venv/
ENV/
env.bak/
venv.bak/

# Environment variables — NEVER commit secrets
.env
*.env
!.env.example

# Generated nutrition plans (runtime output)
nutrition_ai/plans/*.md
!nutrition_ai/plans/sample_nutrition_plan_priya_sharma.md

# IDE / Editor
.vscode/
.idea/
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?
*.swp
*.bak
*~

# OS files
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db
desktop.ini

# Logs
*.log
logs/
*.log.*

# Testing / Coverage
.pytest_cache/
.coverage
htmlcov/
.tox/
nosetests.xml
coverage.xml
*.cover

# Distribution / packaging
.eggs/
MANIFEST

# Jupyter Notebooks
.ipynb_checkpoints/

# Node (if any frontend tooling is added later)
node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
